 "editable": true,
 "panels": [
  {
   "id": 100,
   "type": "text",
   "title": "What am I looking at?",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Monitors:** the AWS services behind money movement: payment functions (Lambda), the API front door (API Gateway) and the PostgreSQL database (RDS).  \n**Source:** Amazon CloudWatch (read through the CloudWatch data source).  \n**Read it like this:** rows = Payments (Lambda), Front door (API Gateway), Database (RDS). Errors and throttles should be 0."
   }
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "Payments: number of payment calls",
   "datasource": {
    "type": "cloudwatch",
    "uid": "cloudwatch"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "cloudwatch",
      "uid": "cloudwatch"
     },
     "queryMode": "Metrics",
     "metricQueryType": 0,
     "metricEditorMode": 0,
     "namespace": "AWS/Lambda",
     "metricName": "Invocations",
     "dimensions": {
      "FunctionName": "paywave-prod-api"
     },
     "statistic": "Sum",
     "period": "300",
     "region": "default",
     "matchExact": true,
     "label": "Lambda invocations (payments)"
    }
   ],
   "description": "Each send-money, QR payment, card top-up, mobile recharge and AutoPay run is one Lambda call."
  },
  {
   "id": 2,
   "type": "timeseries",
